{
  "name": "root",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspaces foreach --all --parallel --topological run dev",
    "build": "yarn workspaces foreach --all --parallel --topological run build",
    "test": "yarn workspaces run test",
    "clean": "yarn workspaces foreach --all --parallel --topological run clean",
    "reset": "rimraf node_modules .yarn/cache .yarn/install-state.gz && yarn workspaces foreach --all --parallel --topological run reset"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  },
  "packageManager": "yarn@4.5.3"
}
