<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>404 - Not Found</title>
  <style>
    body {
      font-family: 'Arial', sans-serif;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 100vh;
      margin: 0;
      background-color: #f7f9fc;
      color: #333;
    }
    .container {
      text-align: center;
      padding: 2rem;
      background-color: white;
      border-radius: 8px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      max-width: 500px;
    }
    h1 {
      font-size: 3rem;
      margin-bottom: 0.5rem;
      color: #e53e3e;
    }
    p {
      font-size: 1.2rem;
      margin-bottom: 2rem;
    }
    .back-button {
      background-color: #3182ce;
      color: white;
      border: none;
      padding: 0.75rem 1.5rem;
      border-radius: 4px;
      font-size: 1rem;
      cursor: pointer;
      text-decoration: none;
      transition: background-color 0.2s;
    }
    .back-button:hover {
      background-color: #2b6cb0;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>404</h1>
    <p><%= message || 'The page you are looking for does not exist.' %></p>
    <a href="/" class="back-button">Go to Homepage</a>
  </div>
</body>
</html>