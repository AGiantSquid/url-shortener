{
  "name": "@url-shortener/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "yarn prisma:deploy && tsx watch --tsconfig tsconfig.dev.json src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "yarn prisma:deploy && node dist/index.js",
    "test": "jest",
    "clean": "rimraf dist tsconfig.tsbuildinfo tsconfig.dev.tsbuildinfo",
    "reset": "rimraf node_modules && yarn clean",
    "prisma:deploy": "yarn prisma:migrate && yarn prisma:generate",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.8.0",
    "@url-shortener/common": "1.0.0",
    "cors": "^2.8.5",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "nanoid": "^5.0.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.19",
    "prisma": "^5.8.0",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.0.4"
  }
}
