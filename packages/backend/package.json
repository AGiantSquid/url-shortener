{
  "name": "@yarn-ts-monorepo/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --tsconfig tsconfig.dev.json src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "jest",
    "clean": "rimraf dist tsconfig.tsbuildinfo tsconfig.dev.tsbuildinfo",
    "reset": "rimraf node_modules && yarn clean"
  },
  "dependencies": {
    "@yarn-ts-monorepo/common": "1.0.0",
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.19",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.0.4"
  }
}
